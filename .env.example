# URL pública do site, sem barra no fim.
#
# Alimenta metadataBase, Open Graph, a tag canonical, o sitemap.xml e o
# robots.txt. Se não for definida, o código cai no domínio de produção
# declarado em content/event.ts.
#
# Defina em preview/staging para que os canonicals e o sitemap apontem para o
# próprio host, e não para produção — canonical apontando para produção faz o
# buscador ignorar o ambiente, e apontando errado tira páginas do índice.
NEXT_PUBLIC_SITE_URL=https://www.meiadecuritiba.com.br

# --- Formulário de contato / Oportunidades ---
# Base do backend (com /api incluído). O route handler acrescenta
# /opportunities ao montar o endpoint final.
CONTACT_API_URL=https://dashboardthomesantos.onrender.com/api
# Token de autenticação (valor puro, sem o "cliente:" do API_TOKENS).
# Armazenar APENAS no .env.local (gitignored) — nunca commite este valor.
CONTACT_API_TOKEN=
